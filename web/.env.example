# API origin (the /v1 base path is added by the client).
VITE_API_URL=http://127.0.0.1:8080
# auth0: Auth0 login (the default for production builds; the three Auth0 values
# below are then required). dev: pick a demo user from the dev server
# (-auth dev); the default for `npm run dev`. Never use dev in production.
VITE_AUTH_MODE=dev
# Only used with VITE_AUTH_MODE=auth0.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
